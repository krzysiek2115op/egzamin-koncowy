<mxfile host="app.diagrams.net" type="device"><diagram name="Schemat techniczny"><mxGraphModel dx="1100" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Schemat techniczny — pipeline MP Offer Builder (11 działów)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1f2a44;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="in" value="Wejście „1 AJAX" (handlowiec) albo hook mp_lead_created (Plugin 1) → szkic. Dane w JSON (MP_OB_Context). Po KAŻDYM dziale bramka QA; błąd = STOP + log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2a44;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="900" height="50" as="geometry"/></mxCell><mxCell id="d1" value="1. Kontrakt wejścia i uprawnienia&#10;2 tryby: nowa / dokończenie draftu · idempotencja · IDOR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="148" width="262" height="92" as="geometry"/></mxCell><mxCell id="d2" value="2. Integracja WooCommerce&#10;ceny produktów + krajowa stawka VAT (jeden odczyt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="316" y="148" width="262" height="92" as="geometry"/></mxCell><mxCell id="e1" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3" value="3. Walidacja pozycji&#10;produkty istnieją, ilości &gt; 0, spójność" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="602" y="148" width="262" height="92" as="geometry"/></mxCell><mxCell id="e2" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d4" value="4. Ceny w groszach&#10;BCMath, liczby całkowite — zero błędów float" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="888" y="148" width="262" height="92" as="geometry"/></mxCell><mxCell id="e3" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d5" value="5. Rabaty&#10;reguły wersjonowane w kodzie, rabat na sumie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="888" y="282" width="262" height="92" as="geometry"/></mxCell><mxCell id="e4" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d6" value="6. Mechanizm VAT&#10;krajowy / odwrotne obciążenie / poza zakresem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="602" y="282" width="262" height="92" as="geometry"/></mxCell><mxCell id="e5" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d7" value="7. Szablon i treść&#10;podstawienie znaczników {{...}} w HTML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="316" y="282" width="262" height="92" as="geometry"/></mxCell><mxCell id="e6" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d8" value="8. Numeracja i wersja&#10;OF/RRRR/NNNNNN · korekta = ten sam numer, wersja+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="282" width="262" height="92" as="geometry"/></mxCell><mxCell id="e7" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d7" target="d8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9" value="9. Render PDF&#10;Dompdf + DejaVu Sans (polskie znaki)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="416" width="262" height="92" as="geometry"/></mxCell><mxCell id="e8" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d8" target="d9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d10" value="10. Zapis transakcyjny (BD-2)&#10;nagłówek + pozycje + wersja + log w jednej transakcji" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#10b981;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="316" y="416" width="262" height="92" as="geometry"/></mxCell><mxCell id="e9" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d9" target="d10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d11" value="11. Odpowiedź i zdarzenie&#10;mp_offer_created wystawiane PO COMMIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#10b981;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="602" y="416" width="262" height="92" as="geometry"/></mxCell><mxCell id="e10" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="d10" target="d11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tx" value="Transakcja: Działy 1–10 · COMMIT przed Działem 11 (mp_offer_created PO COMMIT)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#10b981;fontColor=#059669;fontSize=10;" vertex="1" parent="1"><mxGeometry x="306" y="514" width="282" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>