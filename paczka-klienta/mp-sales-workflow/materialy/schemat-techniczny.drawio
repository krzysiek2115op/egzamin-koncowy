<mxfile host="app.diagrams.net" type="device"><diagram name="Schemat techniczny LP.3"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Schemat techniczny — MP Sales Workflow (LP.3)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1f2a44;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Pipeline 9 działów · 25 par Agent+Krytyk · bramka jakości po każdym dziale · 1 odczyt, 1 transakcja zapisu, 0 wywołań sieciowych" style="text;html=1;fontSize=11;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1100" height="20" as="geometry"/></mxCell><mxCell id="ch1" value="Hak z Pluginu 1&#10;mp_lead_created&#10;&#10;lead.created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="295" height="84" as="geometry"/></mxCell><mxCell id="e_ch1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="ch1" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch2" value="Hak z Pluginu 2&#10;mp_offer_approved&#10;&#10;offer.approved · status.change→offer_draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="353" y="108" width="295" height="84" as="geometry"/></mxCell><mxCell id="e_ch2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="ch2" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch3" value="Panel handlowca&#10;admin-ajax.php · mp_sw_event&#10;&#10;status.change · dashboard.view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7c3aed;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="666" y="108" width="295" height="84" as="geometry"/></mxCell><mxCell id="e_ch3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="ch3" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ch4" value="Harmonogram&#10;cron mp_sw_sweep_tasks&#10;&#10;task.due" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="979" y="108" width="295" height="84" as="geometry"/></mxCell><mxCell id="e_ch4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="ch4" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="gate" value="BRAMA POCHODZENIA ZDARZEŃ — macierz typ ↔ kanał (domknięta domyślnie)&#10;&#10;Typ zdarzenia dozwolony tylko z przypisanego mu kanału; nieznany typ nie ma żadnego źródła.&#10;Odmowa → kod MP3-Exxx + dziennik techniczny (error_log). Zero zapisów w bazie." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#dc2626;fontColor=#7f1d1d;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="218" width="1220" height="74" as="geometry"/></mxCell><mxCell id="d1" value="1. Brama i kontrakt zdarzenia&#10;3 par Agent+Krytyk · bramka jakości&#10;&#10;Walidacja koperty, powtarzalny event_id, trace_id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="390" height="108" as="geometry"/></mxCell><mxCell id="d2" value="2. Strzał odczytu — BD-1&#10;5 par Agent+Krytyk · bramka jakości&#10;&#10;JEDYNY odczyt: proces, role, zespół, lead (P1), oferta (P2)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="455" y="326" width="390" height="108" as="geometry"/></mxCell><mxCell id="ed2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3" value="3. Uprawnienia i zakres roli&#10;2 par Agent+Krytyk · bramka jakości&#10;&#10;WŁASNE / ZESPÓŁ / WSZYSTKIE; cudzy proces = 404." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="326" width="390" height="108" as="geometry"/></mxCell><mxCell id="ed3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d4" value="4. Przypisanie handlowca&#10;3 par Agent+Krytyk · bramka jakości&#10;&#10;Dobór po kraju i języku; brak dopasowania → manager." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="390" height="108" as="geometry"/></mxCell><mxCell id="ed4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d5" value="5. Maszyna statusów&#10;2 par Agent+Krytyk · bramka jakości&#10;&#10;Dozwolone przejścia; blokada wersji (lock_version)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="455" y="452" width="390" height="108" as="geometry"/></mxCell><mxCell id="ed5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d6" value="6. Zadania follow-up&#10;2 par Agent+Krytyk · bramka jakości&#10;&#10;Plan d+3 / d+7 z wartownikiem statusu; jedno otwarte na typ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="452" width="390" height="108" as="geometry"/></mxCell><mxCell id="ed6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d7" value="7. Powiadomienia e-mail&#10;3 par Agent+Krytyk · bramka jakości&#10;&#10;Treść z szablonu, adres z bazy, podpisany link do PDF." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="578" width="390" height="108" as="geometry"/></mxCell><mxCell id="ed7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d8" value="8. Zapis — jedna transakcja&#10;3 par Agent+Krytyk · bramka jakości&#10;&#10;START → zapisy → COMMIT. Wartownik sprawdzany w UPDATE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7c3aed;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="455" y="578" width="390" height="108" as="geometry"/></mxCell><mxCell id="ed8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="d7" target="d8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d9" value="9. Wyjście i kolejka&#10;2 par Agent+Krytyk · bramka jakości&#10;&#10;Odpowiedź + kolejka e-mail uruchamiana PO COMMIT." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#10b981;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="578" width="390" height="108" as="geometry"/></mxCell><mxCell id="ed9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="d8" target="d9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_gate_d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="gate" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tx" value="JEDNA TRANSAKCJA (tylko Dział 8) → BD-1&#10;&#10;wp_mp_sw_flow · wp_mp_sw_tasks · wp_mp_sw_notifications · wp_mp_sw_activity · wp_mp_sw_events&#10;&#10;Wartownik statusu i lock_version sprawdzane WEWNĄTRZ transakcji — konflikt = 409, bez nadpisania." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;fontColor=#4c1d95;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="706" width="1220" height="108" as="geometry"/></mxCell><mxCell id="e_d8_tx" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="d8" target="tx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o0" value="Kolejka e-mail&#10;&#10;wp_mail() dopiero po COMMIT · limit 200/h · ponowienia z odstępem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#10b981;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="393" height="96" as="geometry"/></mxCell><mxCell id="e_tx_o0" value="COMMIT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="tx" target="o0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o1" value="Podpisany link do PDF&#10;&#10;HMAC-SHA256 · ważność 14 dni · jedyne publiczne wejście" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="453" y="852" width="393" height="96" as="geometry"/></mxCell><mxCell id="e_tx_o1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="tx" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="o2" value="Dziennik aktywności&#10;&#10;kto, kiedy, co zmienił · bez adresu e-mail i bez IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#334155;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="866" y="852" width="393" height="96" as="geometry"/></mxCell><mxCell id="e_tx_o2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#94a3b8;fontSize=10;" edge="1" parent="1" source="tx" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>