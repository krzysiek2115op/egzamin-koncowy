<mxfile host="app.diagrams.net" type="device"><diagram name="Schemat techniczny"><mxGraphModel dx="1100" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Schemat techniczny — pipeline MP Offer Builder (11 działów)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1f2a44;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="in" value="Wejście: Handlowiec — żądanie „1 AJAX"  ·  ALBO  ·  Plugin 1 — hook mp_lead_created → szkic (draft).&#10;Dane jednokierunkowo w JSON (MP_OB_Context). Po KAŻDYM dziale bramka QA; błąd = STOP + ROLLBACK (dz. 10) + log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2a44;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1120" height="60" as="geometry"/></mxCell><mxCell id="d1" value="1. Kontrakt wejścia i uprawnienia&#10;2 tryby: nowa / dokończenie draftu · idempotencja (request_id) · IDOR (created_by)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="250" height="84" as="geometry"/></mxCell><mxCell id="d2" value="2. Integracja WooCommerce&#10;ceny + krajowy VAT: WC_Tax::get_base_tax_rates (baza sklepu = PL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="322" y="168" width="250" height="84" as="geometry"/></mxCell><mxCell id="d3" value="3. Walidacja pozycji&#10;produkty istnieją · qty &gt; 0 · spójność" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColo