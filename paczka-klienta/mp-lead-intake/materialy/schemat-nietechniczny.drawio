<mxfile host="app.diagrams.net" type="device">
  <diagram name="Schemat procesu">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Jak działa formularz zapytania — w skrócie" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1f2a44;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="700" height="30" as="geometry"/></mxCell>

        <mxCell id="c1" value="1. Klient wypełnia formularz&#10;&#10;Podaje dane firmy (nazwa, NIP), kontakt i czego potrzebuje." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="80" width="190" height="160" as="geometry"/></mxCell>
        <mxCell id="c2" value="2. System sprawdza i ocenia&#10;&#10;Waliduje dane, wykrywa duplikaty i nadaje punktację (jakość leada)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=10" vertex="1" parent="1"><mxGeometry x="250" y="80" width="190" height="160" as="geometry"/></mxCell>
        <mxCell id="c3" value="3. Potwierdzenie w tle&#10;&#10;Sprawdza NIP/VAT w rejestrach (VIES, Biała lista). Klient nie czeka." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#1f2a44;verticalAlign=top;spacingTop=10" vertex="1" parent="1"><mxGeometry x="460" y="80" width="190" height="160" as="geometry"/></mxCell>
        <mxCell id="c4" value="4. Trafia do handlowca&#10;&#10;Lead zostaje przypisany właściwemu handlowcowi wraz z oceną." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=10" vertex="1" parent="1"><mxGeometry x="670" y="80" width="190" height="160" as="geometry"/></mxCell>
        <mxCell id="c5" value="5. Zapis i historia&#10;&#10;Wszystko zapisane z pełną historią (audyt). Handlowiec kontaktuje się / robi ofertę." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#10b981;fontColor=#1f2a44;verticalAlign=top;spacingTop=10" vertex="1" parent="1"><mxGeometry x="880" y="80" width="200" height="160" as="geometry"/></mxCell>

        <mxCell id="e1" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="html=1;endArrow=block;strokeColor=#94a3b8" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="sum" value="Co to daje?&#10;• Szybko dla klienta — strona nie „wisi”, potwierdzenie NIP/VAT dzieje się w tle.&#10;• Żaden lead nie ginie — duplikaty wykrywane, wszystko trafia do właściwej osoby.&#10;• Zgodność z RODO — zgody ze znacznikiem czasu, adres IP anonimizowany." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e8f0;fontColor=#1f2a44;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1040" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
