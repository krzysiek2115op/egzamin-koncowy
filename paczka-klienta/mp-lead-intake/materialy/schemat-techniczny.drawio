<mxfile host="app.diagrams.net" type="device"><diagram name="Schemat techniczny"><mxGraphModel dx="1100" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Schemat techniczny — pipeline MP Lead Intake (11 działów)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1f2a44;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="in" value="Wejście: gość na stronie — formularz [mp_lead_intake_form] → JEDNO żądanie AJAX (wp_ajax_nopriv_mp_lead_intake_submit).&#10;Dane jednokierunkowo w JSON (MP_Context). Po KAŻDYM dziale bramka QA; błąd = STOP + wpis do BD-3 + alarm do administratora." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2a44;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1120" height="60" as="geometry"/></mxCell><mxCell id="d1" value="1. Pobranie danych z BD-3&#10;wszystko czego pipeline potrzebuje — jednym strzałem, jeden AJAX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="250" height="84" as="geometry"/></mxCell><mxCell id="d2" value="2. Walidacja formularza&#10;struktura · pola wymagane · formaty (e-mail, telefon, NIP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="322" y="168" width="250" height="84" as="geometry"/></mxCell><mxCell id="d3" value="3. NIP / VAT&#10;suma kontrolna NIP · VIES (VAT UE) · Biała lista KAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="604" y="168" width="250" height="84" as="geometry"/></mxCell><mxCell id="d4" value="4. Kraj i segment&#10;ISO 3166-1 · segment · kategoria klienta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="886" y="168" width="250" height="84" as="geometry"/></mxCell><mxCell id="d5" value="5. Zabezpieczenie formularza&#10;nonce (CSRF) · pułapka na roboty · ogranicznik żądań" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="886" y="308" width="250" height="84" as="geometry"/></mxCell><mxCell id="d6" value="6. Zgody&#10;marketing + RODO · data i WERSJA treści zgody" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#10b981;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="604" y="308" width="250" height="84" as="geometry"/></mxCell><mxCell id="d7" value="7. Utworzenie leada&#10;dedup po (kraj, NIP) · scoring · handlowiec · zapis wp_mp_leads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#10b981;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="322" y="308" width="250" height="84" as="geometry"/></mxCell><mxCell id="d8" value="8. Historia aktywności&#10;wpis operacji do wp_mp_activity_log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#10b981;fontColor=#1f2a44;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="250" height="8