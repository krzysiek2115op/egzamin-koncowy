# --- Zależności / build ---
/vendor/
/node_modules/
package-lock.json
*.log

# composer.lock w korzeniu JEST wersjonowany świadomie (od CI 2026-07-22) —
# to zależności narzędzia dev (PHPCS/WPCS), nie frameworka aplikacji; bez
# zacommitowanego locka każdy przebieg CI ciągnąłby inną wersję WPCS, co
# mogłoby zgłosić nowe błędy bez żadnej zmiany w kodzie wtyczki.

# --- Środowisko / sekrety ---
.env
.env.*
*.local.php
wp-config.php
/secrets/

# --- Artefakty ---
*.zip
*.tar.gz
/dist/
/build/
*.cache

# --- Paczka klienta: wersjonujemy WYŁĄCZNIE materiały (schematy + instrukcje).
#     Kod wtyczki bywał tam duplikowany lokalnie na potrzeby ZIP-a do wysyłki —
#     po scaleniu gałęzi każda wtyczka ma własny podkatalog, więc reguły są
#     wypisane dla wszystkich trzech. ZIP-y wydań budowane są z drzewa gita
#     (patrz Releases), nie z tych katalogów. ---
/paczka-klienta/*/mp-lead-intake/
/paczka-klienta/*/mp-offer-builder/
/paczka-klienta/*/mp-sales-workflow/
/paczka-klienta/**/*.zip

# --- IDE / OS ---
.idea/
.vscode/
*.sublime-*
.DS_Store
Thumbs.db
*.swp
*~

# --- WordPress (gdyby ktoś podłożył pełną instalkę obok wtyczek) ---
wp-content/uploads/
wp-content/cache/
