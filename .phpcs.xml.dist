<?xml version="1.0"?>
<ruleset name="Egzamin koncowy - trzy wtyczki">
	<description>
		Standardy kodowania calego projektu (baza: WordPress Coding Standards).
		Do scalenia galezi kazda wtyczka miala wlasny, niezalezny plik regul —
		rozniacy sie WYLACZNIE zakresem plikow, text domain i wyjatkami dla
		zapytan do bazy. Ten plik jest ich suma, bez zadnego rozluznienia
		ponad to, co obowiazywalo osobno.
	</description>

	<!-- Co skanujemy -->
	<file>mp-lead-intake</file>
	<file>mp-offer-builder</file>
	<file>mp-sales-workflow</file>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="ps"/><!-- p = progress, s = pokaz kody sniffow -->

	<exclude-pattern>*/tests/*</exclude-pattern>
	<!--
		Biblioteki zewnetrzne wtyczki 2 (dompdf i zaleznosci). Przed scaleniem
		zakres `<file>mp-offer-builder</file>` obejmowal je bez wyjatku, wiec
		przebieg na korzeniu repo zglaszal tysiace uwag do cudzego kodu.
		Standardy WordPressa dotycza kodu tego projektu, nie vendorow.
	-->
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<!-- Standard bazowy: pełny WordPress (Core + Docs + Extra) -->
	<rule ref="WordPress"/>

	<!-- Minimalna wersja WP dla kontroli zgodności -->
	<config name="minimum_wp_version" value="6.0"/>

	<!-- Text domain każdej z trzech wtyczek (i18n) -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mp-lead-intake"/>
				<element value="mp-offer-builder"/>
				<element value="mp-sales-workflow"/>
			</property>
		</properties>
	</rule>

	<!--
		Prefiks globalny. Kazda wtyczka uzywa wlasnego (MP_*, MP_OB_*, MP_SW_*)
		wlasnie po to, zeby przy jednoczesnej aktywacji wszystkich trzech nie
		doszlo do kolizji nazw klas. WPCS nie potrafi tego wyrazic per katalog.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<severity>0</severity>
	</rule>

	<!--
		=== Reguły świadomie rozluźnione — ta sama decyzja projektowa podjęta
		niezależnie na wszystkich trzech gałęziach, dla tej samej konwencji ===
	-->

	<!-- Konwencja "1 plik = 1 dział": kilka klas (Agent/Krytyk/budowniczy) w pliku działu -->
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<severity>0</severity>
	</rule>
	<!-- Nazwy plików nie muszą odpowiadać jednej klasie (wieloklasowe pliki działów) -->
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>

	<!-- Krótki opis w docblocku nie jest wymagany dla prostych metod (run/getterów) -->
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<severity>0</severity>
	</rule>
	<!-- Trywialne metody (np. konstruktory delegujące) nie wymagają docblocka -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<severity>0</severity>
	</rule>
	<!-- Pliki-zaślepki (index.php "Silence is golden") bez pełnego docblocka pliku -->
	<rule ref="Squiz.Commenting.FileComment.Missing">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.Commenting.FileComment.WrongStyle">
		<severity>0</severity>
	</rule>

	<!--
		=== Zapytania do bazy ===
		Każda wtyczka ma WŁASNE tabele (BD-3, BD-2, BD-1), więc zapytania
		bezpośrednie są zamierzone: wartości użytkownika idą przez
		$wpdb->prepare(), a interpolowane są wyłącznie nazwy tabel pochodzące
		z kodu. Suma wyjątków z trzech osobnych plików reguł.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>*/includes/db/*</exclude-pattern>
		<exclude-pattern>*/includes/pipeline/*</exclude-pattern>
		<exclude-pattern>*/includes/class-mp-offer-builder-lead-listener.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>*/includes/db/*</exclude-pattern>
		<exclude-pattern>*/includes/pipeline/*</exclude-pattern>
		<exclude-pattern>*/includes/class-mp-offer-builder-lead-listener.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders">
		<exclude-pattern>*/includes/db/*</exclude-pattern>
		<exclude-pattern>*/includes/pipeline/*</exclude-pattern>
		<exclude-pattern>*/includes/class-mp-offer-builder-lead-listener.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.SlowDBQuery">
		<exclude-pattern>*/includes/db/*</exclude-pattern>
		<exclude-pattern>*/includes/pipeline/*</exclude-pattern>
		<exclude-pattern>*/includes/class-mp-offer-builder-lead-listener.php</exclude-pattern>
	</rule>
</ruleset>
