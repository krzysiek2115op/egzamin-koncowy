<?xml version="1.0"?>
<ruleset name="Egzamin koncowy - MP Offer Builder">
	<description>
		Standardy kodowania wtyczki MP Offer Builder (baza: WordPress Coding Standards).
		Ten branch jest w pelni odizolowany od mp-lead-intake — wlasna konfiguracja,
		nie dziedziczona.
	</description>

	<!-- Co skanujemy -->
	<file>mp-offer-builder</file>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="ps"/><!-- p = progress, s = pokaz kody sniffow -->

	<exclude-pattern>*/tests/*</exclude-pattern>

	<!-- Standard bazowy: pełny WordPress (Core + Docs + Extra) -->
	<rule ref="WordPress"/>

	<!-- Minimalna wersja WP i PHP dla kontroli zgodności -->
	<config name="minimum_wp_version" value="6.0"/>

	<!-- Text domain wtyczki (i18n) -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mp-offer-builder"/>
			</property>
		</properties>
	</rule>

	<!--
		Prefiks globalny: funkcje mp_offer_builder_*, klasy produktowe MP_Offer_Builder_*.
		WPCS wymaga prefiksu >= 3 znaki. Ta sama swiadoma decyzja co w mp-lead-intake.
		UWAGA: goly prefiks "MP_" NIE jest unikalny miedzy wtyczkami projektu (plugin 1
		go tez uzywa dla generycznego frameworku pipeline'u) — dlatego framework
		pipeline'u tej wtyczki uzywa wlasnego prefiksu MP_OB_*, zeby uniknac kolizji
		nazw klas przy wspolnej instalacji obu wtyczek (patrz plan P-2).
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<severity>0</severity>
	</rule>

	<!--
		=== Reguły świadomie rozluźnione (ta sama decyzja projektowa co w mp-lead-intake,
		podjęta niezależnie dla tej samej konwencji architektonicznej) ===
	-->

	<!-- Konwencja projektu "1 plik = 1 dział": kilka powiązanych klas (Agent/Krytyk/budowniczy) w pliku działu -->
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<severity>0</severity>
	</rule>
	<!-- Nazwy plików nie muszą odpowiadać jednej klasie (wieloklasowe pliki działów) -->
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>

	<!-- Krótki opis w docblocku nie jest wymagany dla prostych metod (run/getterów) -->
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<severity>0</severity>
	</rule>
	<!-- Trywialne metody (np. konstruktory delegujące) nie wymagają docblocka -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<severity>0</severity>
	</rule>
	<!-- Pliki-zaślepki (index.php "Silence is golden") bez pełnego docblocka pliku -->
	<rule ref="Squiz.Commenting.FileComment.Missing">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.Commenting.FileComment.WrongStyle">
		<severity>0</severity>
	</rule>

	<!--
		=== Zapytania do bazy — tylko w warstwie DB/pipeline ===
		Wtyczka z WLASNYMI tabelami (BD-2). Zapytania bezposrednie sa zamierzone;
		wartosci uzytkownika ida przez $wpdb->prepare()/placeholdery, a interpolowane
		sa wylacznie nazwy tabel pochodzace z kodu. Ta sama swiadoma decyzja co w
		mp-lead-intake.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>*/includes/db/*</exclude-pattern>
		<exclude-pattern>*/includes/pipeline/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>*/includes/db/*</exclude-pattern>
		<exclude-pattern>*/includes/pipeline/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders">
		<exclude-pattern>*/includes/db/*</exclude-pattern>
		<exclude-pattern>*/includes/pipeline/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.SlowDBQuery">
		<exclude-pattern>*/includes/db/*</exclude-pattern>
		<exclude-pattern>*/includes/pipeline/*</exclude-pattern>
	</rule>
</ruleset>
